<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Configuración del prototipo (no replicar en un sistema real) -->
  <appSettings>
    <add key="token.minutos" value="30" />
    <add key="usuario.nombre" value="MONSTER" />
    <add key="usuario.clave" value="MONSTER9" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.serviceModel>
    <behaviors>
      <serviceBehaviors>
        <behavior>
          <!-- Publica el WSDL en ?wsdl -->
          <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
          <!-- Los detalles de excepciones internas no se envían al cliente -->
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    <protocolMapping>
      <!-- SOAP 1.1 como el servidor Java -->
      <add binding="basicHttpBinding" scheme="http" />
    </protocolMapping>
    <!-- minFreeMemoryPercentageToActivateService="0": WCF no rechaza el servicio (HTTP 500) cuando el equipo tiene poca RAM libre -->
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" minFreeMemoryPercentageToActivateService="0" />
  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="true" />
  </system.webServer>
</configuration>
