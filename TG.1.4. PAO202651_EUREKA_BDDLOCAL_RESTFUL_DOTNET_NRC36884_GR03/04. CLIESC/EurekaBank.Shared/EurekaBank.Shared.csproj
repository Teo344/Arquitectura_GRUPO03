<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Biblioteca común de los clientes .NET de EurekaBank (escritorio, móvil y web):
    modelo, controlador, servicio REST y vista (componentes Razor con el diseño "Azul").
    No usa APIs de una plataforma concreta para poder compartirse.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ec.edu.monster</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

</Project>
