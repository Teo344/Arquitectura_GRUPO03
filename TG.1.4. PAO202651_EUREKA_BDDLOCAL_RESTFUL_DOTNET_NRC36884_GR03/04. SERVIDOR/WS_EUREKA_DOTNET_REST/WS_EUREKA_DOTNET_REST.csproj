<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Si no está instalado el runtime de .NET 8, corre sobre la versión mayor más reciente -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WS_EUREKA_DOTNET_REST</RootNamespace>
    <AssemblyName>WS_EUREKA_DOTNET_REST</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- La versión que trae SqlClient (9.0.x) tiene vulnerabilidades conocidas -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Las pruebas son archivos sueltos que se ejecutan con: dotnet run ec/edu/monster/pruebas/PruebaX.cs -->
    <Compile Remove="ec\edu\monster\pruebas\**" />
    <!-- Credenciales locales: se copia a la salida si existe (ver conexion.json.example) -->
    <Content Update="conexion.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Remove="conexion.json.example" />
    <None Include="conexion.json.example" />
  </ItemGroup>

</Project>
