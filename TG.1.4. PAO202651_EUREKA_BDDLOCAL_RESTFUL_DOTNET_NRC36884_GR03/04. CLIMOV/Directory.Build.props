<Project>
  <!-- La ruta de esta carpeta es tan larga que aapt2 (MAUI Android) no puede abrir los archivos de obj\
       ("failed to open file"). Por eso bin y obj se generan en %LOCALAPPDATA%\MonsterBuild, igual que
       el cliente de escritorio (04. CLIESC\Directory.Build.props). -->
  <PropertyGroup>
    <CarpetaCompilacion>$(LOCALAPPDATA)\MonsterBuild\TG.1.4\$(MSBuildProjectName)\</CarpetaCompilacion>
    <BaseIntermediateOutputPath>$(CarpetaCompilacion)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CarpetaCompilacion)bin\</BaseOutputPath>
    <!-- Ignora las carpetas bin/obj viejas que hayan quedado dentro del proyecto -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
