<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!--
      Cliente móvil de EurekaBank (RESTful .NET, Grupo 03): aplicación MAUI Blazor Hybrid para
      Android. Solo aloja la vista; modelo, controlador, servicio y pantallas están en
      EurekaBank.Shared, la misma biblioteca del cliente de escritorio.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>ec.edu.monster</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>EurekaBank Monster REST</ApplicationTitle>
        <ApplicationId>ec.edu.monster.cliente_movil_rest_eureka_dotnet</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Genera un .apk instalable directamente en el celular (en Release el valor por defecto es .aab) -->
        <AndroidPackageFormat>apk</AndroidPackageFormat>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Icono y pantalla de inicio: el banco blanco sobre el azul de acción (#1D56CC) -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1D56CC" />
        <MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#1D56CC" BaseSize="128,128" />
        <!-- servidor.json: URL del servidor REST (RNF-010) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\04. CLIESC\EurekaBank.Shared\EurekaBank.Shared.csproj" />
    </ItemGroup>

</Project>
