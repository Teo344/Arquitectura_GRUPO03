<?xml version="1.0" encoding="UTF-8"?>
<!-- Funciones EL de la vista: los formatos y fichas del cliente de escritorio (vista/Formato y vista/Fichas). -->
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>e</short-name>
    <uri>http://monster.edu.ec/eureka</uri>

    <function>
        <description>Importe con separador de miles y dos decimales: 6,900.00</description>
        <name>importe</name>
        <function-class>ec.edu.monster.vista.Formato</function-class>
        <function-signature>java.lang.String importe(java.math.BigDecimal)</function-signature>
    </function>
    <function>
        <description>Hora local (HH:mm) de un instante</description>
        <name>hora</name>
        <function-class>ec.edu.monster.vista.Formato</function-class>
        <function-signature>java.lang.String hora(java.time.Instant)</function-signature>
    </function>
    <function>
        <description>El valor, o "-" si no hay</description>
        <name>valorO</name>
        <function-class>ec.edu.monster.vista.Formato</function-class>
        <function-signature>java.lang.String valorO(java.lang.String)</function-signature>
    </function>
    <function>
        <description>Filas del comprobante de una operación registrada</description>
        <name>comprobante</name>
        <function-class>ec.edu.monster.vista.Fichas</function-class>
        <function-signature>java.util.List comprobante(ec.edu.monster.modelo.TransaccionModelo, ec.edu.monster.modelo.ResultadoTransaccionModelo)</function-signature>
    </function>
    <function>
        <description>Filas del resumen de confirmación</description>
        <name>resumen</name>
        <function-class>ec.edu.monster.vista.Fichas</function-class>
        <function-signature>java.util.List resumen(ec.edu.monster.modelo.TransaccionModelo)</function-signature>
    </function>
</taglib>
