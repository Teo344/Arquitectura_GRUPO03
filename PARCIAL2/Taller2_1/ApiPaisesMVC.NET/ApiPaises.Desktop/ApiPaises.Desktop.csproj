<Project Sdk="Microsoft.NET.Sdk.Razor">

    <!--
      Aplicación de escritorio de ApiPaisesMVC .NET (Taller 2.1, Grupo 03): MAUI Blazor Hybrid para
      Windows, igual que los clientes de escritorio .NET de TG.1.4. Solo aloja la ventana y arma las
      dependencias; modelo, servicio, controlador y vista están en ApiPaises.Shared.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>ec.edu.monster</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <ApplicationTitle>Países API</ApplicationTitle>
        <ApplicationId>ec.edu.monster.apipaises.escritorio</ApplicationId>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Aplicación sin empaquetar: se ejecuta directamente con F5 desde Visual Studio -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Icono: el globo blanco sobre el azul de acción (#1D56CC) -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1D56CC" />
        <!-- configuracion.json: cadena de conexión a SQL Server y API key de REST Countries -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ApiPaises.Shared\ApiPaises.Shared.csproj" />
    </ItemGroup>

</Project>
