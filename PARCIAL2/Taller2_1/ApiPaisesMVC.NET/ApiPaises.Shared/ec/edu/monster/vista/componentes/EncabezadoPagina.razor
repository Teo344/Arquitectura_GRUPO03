@*
    Encabezado de página: sobretítulo, título (h1, recibe el foco al navegar) y una línea de apoyo a
    la izquierda; las acciones de la página, abajo a la derecha.
*@
<header class="ap-encabezado">
    <div class="ap-encabezado__textos">
        <div class="eb-sobretitulo">@Sobretitulo</div>
        <h1 class="eb-h3" tabindex="-1">@Titulo</h1>
        @if (Apoyo != null)
        {
            <p class="eb-cuerpo eb-texto-secundario" role="status">@Apoyo</p>
        }
    </div>
    @if (Acciones != null)
    {
        <div class="ap-encabezado__acciones">@Acciones</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Sobretitulo { get; set; } = "";
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Apoyo { get; set; }
    [Parameter] public RenderFragment? Acciones { get; set; }
}
