@* Tarjeta: fondo blanco, borde #D3DCEA, radio 16, sombra md (tinte #12306A) y padding 24. *@
<section class="eb-tarjeta @Clase" aria-label="@Etiqueta">
    @ChildContent
</section>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Clase { get; set; }
    /// <summary>Nombre accesible de la sección (opcional).</summary>
    [Parameter] public string? Etiqueta { get; set; }
}
