@*
    Búsqueda por nombre en la API (Actividad 1). Solo busca al pulsar "Buscar" (cada consulta gasta
    cuota de la clave); cada resultado indica si ya está guardado en SQL Server. Si la API falla, el
    servicio responde con la base local y aquí se avisa.
*@
@using System.Globalization
@model BusquedaVistaModelo
@{
    ViewData["Titulo"] = "Buscar en la API";
    ViewData["Seccion"] = "busqueda";
    string[] sugerencias = { "ecuador", "japan", "españa", "guinea" };
    EstadoVacio inicial = new EstadoVacio(NombreIcono.Buscar, "Busca un país en la API",
        "Los resultados aparecerán aquí. Podrás guardar en la base de datos los que necesites.");
}

<section class="ap-banda" aria-labelledby="titulo-busqueda">
    <span class="ap-sobretitulo">Actividad 1</span>
    <h1 class="ap-banda__titulo" id="titulo-busqueda">Buscar un país en REST Countries</h1>
    <p class="ap-banda__texto">
        Busca por nombre común, oficial o nativo («ecuador», «germany», «españa»). Cada búsqueda consume una consulta de la cuota mensual de tu clave.
    </p>
    <form method="get" asp-controller="PaisControlador" asp-action="Busqueda" class="ap-banda__formulario" role="search">
        <label class="ap-campo-icono">
            <span class="ap-oculto">Nombre del país</span>
            @Iconos.Svg(NombreIcono.Buscar)
            <input class="ap-campo__entrada" id="consulta" name="consulta" type="search" value="@Model.Nombre" maxlength="100"
                   placeholder="Ej. ecuador" autocomplete="off" autofocus="@(Model.Resultado == null)" />
        </label>
        <button type="submit" class="ap-boton ap-boton--acento" data-cargando="Buscando…">Buscar</button>
    </form>
    <div class="ap-sugerencias">
        <span>Prueba con:</span>
        @foreach (string sugerencia in sugerencias)
        {
            <a class="ap-sugerencia" asp-controller="PaisControlador" asp-action="Busqueda" asp-route-consulta="@sugerencia"
               title="Buscar «@sugerencia»">@sugerencia</a>
        }
    </div>
</section>

@if (Model.Error != null)
{
    <partial name="~/ec/edu/monster/vista/componentes/_Alerta.cshtml" model="new Alerta(TipoAlerta.Info, Model.Error)" />
}

@if (Model.Resultado == null)
{
    <partial name="~/ec/edu/monster/vista/componentes/_EstadoVacio.cshtml" model="inicial" />
}
else
{
    ResultadoBusqueda resultado = Model.Resultado;
    string texto = Model.Nombre?.Trim() ?? "";
    if (!Model.DesdeApi && resultado.Aviso != null)
    {
        <partial name="~/ec/edu/monster/vista/componentes/_Alerta.cshtml" model="new Alerta(TipoAlerta.Advertencia, resultado.Aviso)" />
    }

    if (resultado.EstaVacio)
    {
        EstadoVacio sinResultados = new EstadoVacio(NombreIcono.Buscar, "Sin coincidencias",
            (Model.DesdeApi ? "La API" : "La base local") + " no tiene países con «" + texto
            + "». Prueba con el nombre en inglés o en su idioma oficial.");
        <partial name="~/ec/edu/monster/vista/componentes/_EstadoVacio.cshtml" model="sinResultados" />
    }
    else
    {
        <section aria-labelledby="titulo-resultados" style="display:flex;flex-direction:column;gap:12px">
            <div class="ap-resultados__cabecera">
                <h2 class="ap-h5" id="titulo-resultados">
                    @(resultado.Paises.Count == 1 ? "1 coincidencia" : resultado.Paises.Count + " coincidencias") para «@texto»
                </h2>
                <partial name="~/ec/edu/monster/vista/componentes/_ChipEstado.cshtml"
                         model='Model.DesdeApi ? new ChipEstado(TipoAlerta.Exito, "Datos en vivo de la API") : new ChipEstado(TipoAlerta.Advertencia, "Datos de la base local")' />
            </div>
            <div class="ap-resultados">
                @foreach (Pais pais in resultado.Paises)
                {
                    bool guardado = Model.EstaGuardado(pais);
                    <article class="ap-resultado" aria-label="@pais.Nombre">
                        <div class="ap-resultado__cabecera">
                            <span class="ap-codigo-chip">@pais.Codigo</span>
                            <h3 class="ap-resultado__nombre">@pais.Nombre</h3>
                            @if (pais.Region != null)
                            {
                                <span class="ap-region-chip">@pais.Region.Value.Nombre()</span>
                            }
                        </div>
                        <dl class="ap-resultado__datos">
                            <div><dt>Capital</dt><dd>@Formato.Texto(pais.Capital)</dd></div>
                            <div><dt>Población</dt><dd class="ap-numero">@Formato.Entero(pais.Poblacion)</dd></div>
                            <div><dt>Moneda</dt><dd>@Formato.Texto(pais.Moneda)</dd></div>
                            <div><dt>Subregión</dt><dd>@Formato.Texto(pais.SubRegion)</dd></div>
                            <div><dt>Área</dt><dd class="ap-numero">@Formato.Area(pais.Area)</dd></div>
                        </dl>
                        <div class="ap-resultado__pie">
                            @if (!Model.DesdeApi)
                            {
                                <span class="ap-resultado__estado">Guardado en la base local</span>
                            }
                            else
                            {
                                if (guardado)
                                {
                                    <span class="ap-resultado__estado ap-resultado__estado--guardado">@Iconos.Svg(NombreIcono.Exito, 16)Ya está en tu base</span>
                                }
                                else
                                {
                                    <span class="ap-resultado__estado">No guardado todavía</span>
                                }
                                <form method="post" asp-controller="PaisControlador" asp-action="GuardarResultado">
                                    <input type="hidden" name="consulta" value="@texto" />
                                    <input type="hidden" name="Codigo" value="@pais.Codigo" />
                                    <input type="hidden" name="Nombre" value="@pais.Nombre" />
                                    <input type="hidden" name="Capital" value="@pais.Capital" />
                                    <input type="hidden" name="Region" value="@pais.Region" />
                                    <input type="hidden" name="SubRegion" value="@pais.SubRegion" />
                                    <input type="hidden" name="Poblacion" value="@pais.Poblacion.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="Area" value="@pais.Area.ToString(CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="Moneda" value="@pais.Moneda" />
                                    @if (guardado)
                                    {
                                        <button type="submit" class="ap-boton ap-boton--secundario" data-cargando="Guardando…"
                                                aria-label="Actualizar @pais.Nombre en la base de datos">
                                            @Iconos.Svg(NombreIcono.Actualizar)<span>Actualizar datos</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="ap-boton ap-boton--primario" data-cargando="Guardando…"
                                                aria-label="Guardar @pais.Nombre en la base de datos">
                                            @Iconos.Svg(NombreIcono.Descargar)<span>Guardar en SQL Server</span>
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
}
