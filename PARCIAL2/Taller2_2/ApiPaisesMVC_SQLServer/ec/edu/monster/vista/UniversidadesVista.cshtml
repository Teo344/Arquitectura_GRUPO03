@*
    Actividad avanzada: consume la API pública de universidades (Hipolabs) y guarda Nombre, Dominio,
    Sitio web y País en SQL Server con la entidad Universidad. La tabla está paginada como la de países.
*@
@using Microsoft.AspNetCore.Routing
@model UniversidadesVistaModelo
@{
    ViewData["Titulo"] = "Universidades";
    ViewData["Seccion"] = "universidades";
    string resumen = Model.ErrorCarga != null
        ? "No se pudieron cargar las universidades."
        : Model.TotalGuardadas == 0
            ? "Aún no hay universidades guardadas en SQL Server."
            : Model.PaisFiltro == null
                ? Formato.Universidades(Model.TotalGuardadas) + " guardadas en SQL Server"
                : Formato.Universidades(Model.ConteoPorPais.FirstOrDefault(c => string.Equals(c.Key, Model.PaisFiltro, StringComparison.OrdinalIgnoreCase)).Value) + " de " + Model.PaisFiltro;
    if (Model.ErrorCarga == null && Model.TieneTexto)
    {
        resumen += " · " + Formato.Entero(Model.Universidades.Count) + " coinciden con «" + Model.Texto + "»";
    }

    Func<int, int, string> urlPagina = (pagina, tamano) =>
    {
        RouteValueDictionary r = new RouteValueDictionary();
        if (Model.PaisFiltro != null) { r["pais"] = Model.PaisFiltro; }
        if (Model.TieneTexto) { r["texto"] = Model.Texto; }
        if (tamano != OpcionesLista.TamanoPorDefecto) { r["tamano"] = tamano; }
        if (pagina > 1) { r["pagina"] = pagina; }
        return Url.Action("Index", "UniversidadControlador", r) ?? "/universidades";
    };
    Paginacion paginacion = Paginacion.Crear(Model.Universidades.Count, Model.Lista.PaginaValida, Model.Lista.TamanoValido,
        urlPagina, "universidades");
}

<header class="ap-encabezado">
    <div class="ap-encabezado__textos">
        <span class="ap-sobretitulo">Actividad avanzada</span>
        <h1 class="ap-h3">Universidades</h1>
        <p class="ap-texto-secundario">@resumen</p>
    </div>
    <form method="post" asp-controller="UniversidadControlador" asp-action="Importar" class="ap-busqueda"
          aria-label="Importar universidades desde la API">
        <label class="ap-campo-icono" title="País en inglés, por ejemplo Ecuador, Peru, Colombia o Spain">
            <span class="ap-oculto">País (en inglés)</span>
            @Iconos.Svg(NombreIcono.Ubicacion)
            <input class="ap-campo__entrada" id="pais" name="pais" value="@Model.PaisImportar" maxlength="100"
                   placeholder="País en inglés, ej. Ecuador" autocomplete="off" />
        </label>
        <button type="submit" class="ap-boton ap-boton--primario" data-cargando="Importando…">
            @Iconos.Svg(NombreIcono.Descargar)<span>Importar universidades</span>
        </button>
    </form>
</header>

@if (Model.ConteoPorPais.Count > 0)
{
<div class="ap-herramientas">
    @* Búsqueda por nombre, dominio o sitio web; se combina con el filtro por país *@
    <form method="get" asp-controller="UniversidadControlador" asp-action="Index" class="ap-busqueda" role="search"
          aria-label="Buscar universidades">
        <label class="ap-campo-icono">
            <span class="ap-oculto">Buscar por nombre, dominio o sitio web</span>
            @Iconos.Svg(NombreIcono.Buscar)
            <input class="ap-campo__entrada" id="texto" name="texto" type="search" value="@Model.Texto" maxlength="100"
                   placeholder="Nombre, dominio o sitio web" autocomplete="off" />
        </label>
        @if (Model.PaisFiltro != null)
        {
            <input type="hidden" name="pais" value="@Model.PaisFiltro" />
        }
        @if (Model.Lista.TamanoValido != OpcionesLista.TamanoPorDefecto)
        {
            <input type="hidden" name="tamano" value="@Model.Lista.TamanoValido" />
        }
        <button type="submit" class="ap-boton ap-boton--secundario">Buscar</button>
        @if (Model.TieneTexto)
        {
            <a class="ap-boton ap-boton--texto" asp-controller="UniversidadControlador" asp-action="Index"
               asp-route-pais="@Model.PaisFiltro">Limpiar</a>
        }
    </form>

    <nav class="ap-filtros" aria-label="Filtrar por país">
        <a class="ap-filtro @(Model.PaisFiltro == null ? "ap-filtro--elegido" : "")" aria-current="@(Model.PaisFiltro == null ? "true" : null)"
           asp-controller="UniversidadControlador" asp-action="Index" asp-route-texto="@Model.Texto">
            Todos <span class="ap-filtro__conteo">@Formato.Entero(Model.TotalGuardadas)</span>
        </a>
        @foreach (KeyValuePair<string, long> conteo in Model.ConteoPorPais)
        {
            bool elegido = string.Equals(Model.PaisFiltro, conteo.Key, StringComparison.OrdinalIgnoreCase);
            <a class="ap-filtro @(elegido ? "ap-filtro--elegido" : "")" aria-current="@(elegido ? "true" : null)"
               asp-controller="UniversidadControlador" asp-action="Index" asp-route-pais="@conteo.Key" asp-route-texto="@Model.Texto">
                @conteo.Key <span class="ap-filtro__conteo">@Formato.Entero(conteo.Value)</span>
            </a>
        }
    </nav>
</div>
}

<section class="ap-tabla-tarjeta" aria-label="Universidades registradas">
    @if (Model.ErrorCarga != null)
    {
        EstadoVacio sinBase = new EstadoVacio(NombreIcono.BaseDatos, "No se pudo cargar la lista", Model.ErrorCarga,
            "Reintentar", "/universidades");
        <partial name="~/ec/edu/monster/vista/componentes/_EstadoVacio.cshtml" model="sinBase" />
    }
    else if (Model.Universidades.Count == 0 && Model.TieneTexto)
    {
        EstadoVacio sinCoincidencias = new EstadoVacio(NombreIcono.Buscar, "Sin coincidencias",
            "Ninguna universidad" + (Model.PaisFiltro != null ? " de " + Model.PaisFiltro : "") + " contiene «" + Model.Texto
            + "» en el nombre, el dominio o el sitio web.", "Limpiar búsqueda",
            Url.Action("Index", "UniversidadControlador", new { pais = Model.PaisFiltro }));
        <partial name="~/ec/edu/monster/vista/componentes/_EstadoVacio.cshtml" model="sinCoincidencias" />
    }
    else if (Model.Universidades.Count == 0)
    {
        EstadoVacio vacio = Model.PaisFiltro == null
            ? new EstadoVacio(NombreIcono.Escuela, "Aún no hay universidades",
                "Escribe un país en inglés y pulsa «Importar universidades».")
            : new EstadoVacio(NombreIcono.Escuela, "No hay universidades de " + Model.PaisFiltro,
                "Impórtalas con el formulario de arriba o elige otro país.", "Ver todos los países", "/universidades");
        <partial name="~/ec/edu/monster/vista/componentes/_EstadoVacio.cshtml" model="vacio" />
    }
    else
    {
        <div class="ap-tabla-caja">
            <table class="ap-tabla">
                <caption class="ap-oculto">Universidades registradas, ordenadas por país y nombre; página @paginacion.Pagina de @paginacion.TotalPaginas</caption>
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Dominio</th>
                        <th scope="col">Sitio web</th>
                        <th scope="col">País</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Universidad universidad in paginacion.Cortar(Model.Universidades))
                    {
                        <tr>
                            <td class="ap-tabla__destacada">@universidad.Nombre</td>
                            <td><span class="ap-codigo-chip" style="letter-spacing:0">@Formato.Texto(universidad.Dominio)</span></td>
                            <td>
                                @if (universidad.SitioWeb != null && Uri.TryCreate(universidad.SitioWeb, UriKind.Absolute, out Uri? sitio)
                                     && (sitio.Scheme == Uri.UriSchemeHttp || sitio.Scheme == Uri.UriSchemeHttps))
                                {
                                    <a class="ap-enlace" href="@sitio" target="_blank" rel="noopener noreferrer" style="padding:0">
                                        <span>@sitio.Host</span>@Iconos.Svg(NombreIcono.Enlace, 14)<span class="ap-oculto">(se abre en otra pestaña)</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="ap-tabla__vacio">@Formato.Texto(universidad.SitioWeb)</span>
                                }
                            </td>
                            <td><span class="ap-region-chip">@universidad.Pais</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="~/ec/edu/monster/vista/componentes/_Paginador.cshtml" model="paginacion" />
    }
</section>
