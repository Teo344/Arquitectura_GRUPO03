@*
    Pantalla principal (layout): barra superior azul oscuro con la marca, las pestañas de cada
    sección, el estado de SQL Server y el regreso al inicio; debajo, el contenido de la sección
    elegida a todo el ancho. Cada sección es una vista independiente que solo conoce los datos que
    le entrega su controlador.
*@
@inject ec.edu.monster.servicio.PaisServicio Servicio
@{
    string seccion = ViewData["Seccion"] as string ?? "";
    (string Clave, string Titulo, NombreIcono Icono, string Url)[] secciones =
    {
        ("paises", "Países", NombreIcono.Tabla, "/paises"),
        ("busqueda", "Buscar en la API", NombreIcono.Buscar, "/busqueda"),
        ("reportes", "Reportes", NombreIcono.Grafico, "/reportes"),
        ("universidades", "Universidades", NombreIcono.Escuela, "/universidades")
    };
    // Solo cuenta filas (no consulta la API): la barra informa si SQL Server responde
    EstadoSistema estado = await Servicio.VerificarEstadoAsync();
    string textoEstado = estado.BaseDisponible ? "SQL Server conectado" : "SQL Server sin conexión";
    string detalleEstado = estado.BaseDisponible ? Formato.Paises(estado.TotalPaises) + " en ApiPaisesDB"
        : estado.DetalleBase ?? "La base de datos no respondió.";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] · Países API</title>
    <link rel="stylesheet" href="~/css/paises.css" asp-append-version="true" />
</head>
<body>
    <header class="ap-barra-superior">
        <a class="ap-marca" href="/" aria-label="Países API, volver al inicio" data-proteger>
            <span class="ap-icono-caja ap-icono-caja--accion">@Iconos.Svg(NombreIcono.Publico, 20)</span>
            <span class="ap-marca__nombre">PAÍSES API</span>
        </a>
        <nav aria-label="Secciones" style="align-self:stretch;min-width:0;display:flex">
            <ul class="ap-pestanas">
                @foreach (var opcion in secciones)
                {
                    bool elegida = opcion.Clave == seccion;
                    <li>
                        <a class="ap-pestana @(elegida ? "ap-pestana--elegida" : "")" href="@opcion.Url"
                           aria-current="@(elegida ? "page" : null)" data-proteger>
                            @Iconos.Svg(opcion.Icono, 18)
                            <span>@opcion.Titulo</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>
        <div class="ap-barra-superior__derecha">
            <span class="ap-estado-base @(estado.BaseDisponible ? "" : "ap-estado-base--error")" title="@detalleEstado">
                <span class="ap-estado-base__punto" aria-hidden="true"></span>
                <span>@textoEstado</span>
            </span>
            <a class="ap-boton-claro" href="/" title="Volver a la pantalla de inicio" data-proteger>
                @Iconos.Svg(NombreIcono.Anterior, 18)<span>Inicio</span>
            </a>
        </div>
    </header>

    <main class="ap-principal">
        <partial name="~/ec/edu/monster/vista/componentes/_Avisos.cshtml" />
        @RenderBody()
    </main>

    @RenderSection("Panel", required: false)
    @RenderSection("Dialogos", required: false)
    <script src="~/js/paises.js" asp-append-version="true"></script>
</body>
</html>
