@*
    Pantalla principal (layout): menú lateral fijo y el contenido de la sección elegida. Cada sección
    es una vista independiente que solo conoce los datos que le entrega su controlador.
*@
@{
    string seccion = ViewData["Seccion"] as string ?? "";
    (string Clave, string Titulo, NombreIcono Icono, string Url)[] secciones =
    {
        ("paises", "Países", NombreIcono.Tabla, "/paises"),
        ("busqueda", "Buscar en la API", NombreIcono.Buscar, "/busqueda"),
        ("reportes", "Reportes", NombreIcono.Grafico, "/reportes"),
        ("universidades", "Universidades", NombreIcono.Escuela, "/universidades")
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Titulo"] · Países API</title>
    <link rel="stylesheet" href="~/css/paises.css" asp-append-version="true" />
</head>
<body>
    <div class="ap-app">
        <aside class="ap-menu">
            <div class="ap-menu__navegacion">
                <a class="ap-marca" href="/" aria-label="Países API, volver al inicio">
                    <span class="ap-icono-caja ap-icono-caja--accion">@Iconos.Svg(NombreIcono.Publico, 22)</span>
                    <span>
                        <span class="ap-marca__nombre">PAÍSES API</span>
                        <span class="ap-marca__detalle" style="display:block">Taller 2.2 · Grupo 03</span>
                    </span>
                </a>
                <p class="ap-menu__titulo" id="menu-titulo">Menú</p>
                <nav aria-labelledby="menu-titulo">
                    <ul class="ap-menu__lista">
                        @foreach (var opcion in secciones)
                        {
                            bool elegida = opcion.Clave == seccion;
                            <li>
                                <a class="ap-menu__item @(elegida ? "ap-menu__item--elegido" : "")" href="@opcion.Url"
                                   aria-current="@(elegida ? "page" : null)" data-proteger>
                                    @Iconos.Svg(opcion.Icono)
                                    <span>@opcion.Titulo</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
            <a class="ap-menu__item" href="/" data-proteger>
                @Iconos.Svg(NombreIcono.Salir)
                <span>Volver al inicio</span>
            </a>
        </aside>

        <main class="ap-principal">
            <div class="ap-centrado">
                <partial name="~/ec/edu/monster/vista/componentes/_Avisos.cshtml" />
                @RenderBody()
            </div>
        </main>
    </div>

    @RenderSection("Dialogos", required: false)
    <script src="~/js/paises.js" asp-append-version="true"></script>
</body>
</html>
