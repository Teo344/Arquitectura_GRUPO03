<Project>
  <!-- La ruta de esta carpeta es tan larga que obj\...\win-x64\ supera los 260 caracteres y MakePri (MAUI Windows)
       falla con "no se encuentra la ruta". Por eso bin y obj se generan en %LOCALAPPDATA%\MonsterBuild
       (mismo arreglo que el cliente de escritorio de TI.1.2). -->
  <PropertyGroup>
    <CarpetaCompilacion>$(LOCALAPPDATA)\MonsterBuild\TG.1.2\$(MSBuildProjectName)\</CarpetaCompilacion>
    <BaseIntermediateOutputPath>$(CarpetaCompilacion)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(CarpetaCompilacion)bin\</BaseOutputPath>
    <!-- Ignora las carpetas bin/obj viejas que hayan quedado dentro del proyecto -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
