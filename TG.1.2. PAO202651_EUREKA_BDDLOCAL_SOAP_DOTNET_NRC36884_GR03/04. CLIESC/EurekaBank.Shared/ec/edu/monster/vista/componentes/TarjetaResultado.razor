@* Ficha de una operación registrada: encabezado de éxito con icono y las filas de datos. *@
<Tarjeta>
    <div class="eb-encabezado">
        <IconoEnCaja IconoCaja="NombreIcono.Exito" Estilo="exito" Tamano="44" />
        <div class="eb-encabezado__textos">
            <div class="eb-sobretitulo eb-texto-exito">Operación registrada</div>
            <div class="eb-h4">@Mensaje</div>
        </div>
    </div>
    <hr class="eb-divisor eb-espacio-m" />
    @for (int i = 0; i < Filas.Count; i++)
    {
        <FilaDato Etiqueta="@Filas[i].Etiqueta" Valor="@Filas[i].Valor" Destacado="@(i == 0)" />
    }
</Tarjeta>

@code {
    [Parameter, EditorRequired] public string Mensaje { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<(string Etiqueta, string Valor)> Filas { get; set; } = [];
}
