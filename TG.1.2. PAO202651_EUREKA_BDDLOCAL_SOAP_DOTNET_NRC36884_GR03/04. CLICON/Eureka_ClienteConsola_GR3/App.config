<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- URL del servidor WCF WS_EUREKA_DOTNET_SOAP (IIS Express); en otra PC: http://IP:8096 -->
        <add key="servidor.url" value="http://localhost:8096" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>
