<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vista="clr-namespace:ec.edu.monster.vista;assembly=EurekaBank.Shared"
             x:Class="ec.edu.monster.MainPage"
             BackgroundColor="{StaticResource Superficie}"
             SafeAreaEdges="All">

    <!-- Las pantallas (login, menú, consultas y transacciones) son componentes de EurekaBank.Shared.
         SafeAreaEdges evita que la barra de estado de Android tape la vista. -->
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type vista:Rutas}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
